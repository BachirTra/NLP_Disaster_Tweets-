.PHONY: install lint format test test-cov train api docker-build clean

install:
	pip install -r requirements.txt

lint:
	ruff check src/ tests/
	mypy src/

format:
	black src/ tests/ notebooks/

test:
	pytest tests/ -v

test-cov:
	pytest tests/ -v --cov=src --cov-report=html --cov-fail-under=80

train:
	python src/models/trainer.py --config settings/model_config.yaml

api:
	uvicorn src.api.main:app --reload --port 8000

docker-build:
	docker-compose up --build

mlflow-ui:
	mlflow ui --backend-store-uri mlflow/

clean:
	find . -type d -name "__pycache__" -exec rm -rf {} +
	find . -name "*.pyc" -delete
	rm -rf .pytest_cache htmlcov .coverage